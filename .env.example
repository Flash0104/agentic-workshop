# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NVIDIA Nemotron Configuration (Text Generation, Question Gen, Evaluation)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Candidate models:
# - nvidia/nemotron-3.5-lightning-30b-a3b (recommended active NIM model)
# - nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# OpenAI Configuration (Live Voice / Realtime WebRTC & Whisper only)
OPENAI_API_KEY=sk-your-openai-api-key
REALTIME_MODEL=gpt-realtime
TTS_MODEL=tts-1
MAX_TURN_TOKENS=1024
MAX_OUTPUT_TOKENS=1024
MAX_TURNS_PER_SESSION=20

# Optional: PostHog Analytics
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
